# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables, then redeploy.
# Full guide: docs/chat-setup.md

# --- Required for the chat ---------------------------------------------------
ANTHROPIC_API_KEY=

# --- Optional: admin page at /admin (404 when unset) --------------------------
# Use 12+ characters, e.g. the output of `openssl rand -base64 24`.
ADMIN_PASSWORD=

# --- Optional: shared store for /admin numbers and saved settings -------------
# Free Upstash Redis. Vercel's Upstash integration sets KV_REST_API_URL and
# KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: let the AI draft messages that visitors send to you ------------
# Free Resend account (the same key GameHub uses works). Without a verified
# domain, Resend only delivers to the address the account was registered with.
# Report and guide: docs/contact-tool-report.md
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=Portfolio chat <onboarding@resend.dev>

# --- Optional: chat behaviour (defaults shown; /admin overrides these) --------
# CHAT_ENABLED=true
# CHAT_MODEL=claude-haiku-5-5        # or claude-sonnet-5-5, claude-opus-5-5
# CHAT_EFFORT=low                    # low | medium | high
# CHAT_LOG_CONTENT=false             # true: save questions and answers in traces
# CHAT_MAX_QUESTIONS=6
# CHAT_MAX_QUESTION_CHARS=300
# CHAT_MAX_OUTPUT_TOKENS=1024
# CHAT_DEVICE_PER_HOUR=15
# CHAT_DEVICE_PER_DAY=30
# CHAT_IP_PER_HOUR=30
# CHAT_IP_PER_DAY=60
# CHAT_GLOBAL_PER_HOUR=300
# CHAT_GLOBAL_PER_DAY=1500
# CHAT_CONTACT_TOOL=true            # false: never offer the draft-a-message tool
# CHAT_MAIL_PER_DAY=20               # whole site; also 2/device and 3/IP per day
# CHAT_DAILY_BUDGET_USD=0.5          # 0 = no cap
# CHAT_MONTHLY_BUDGET_USD=5          # 0 = no cap

# --- Site ---------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
